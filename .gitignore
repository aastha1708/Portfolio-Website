# dependencies
node_modules

# build output
.next
out
next-env.d.ts
*.tsbuildinfo

# environment / deploy
.env*
.vercel

# os / editor noise
.DS_Store
*.log

# Heavy design reference — kept locally, not versioned.
# design/assets-source IS tracked: it's the source of truth for the asset pipeline.
design/inspirations/
design/versions/

# Agent skills live globally in ~/.claude/skills (keep repo lean)
.claude/skills/
